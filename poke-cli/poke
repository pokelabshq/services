#!/usr/bin/env python3
"""Poke CLI v1 — Command-line interface for Poke Labs services.
Usage: poke <command> [args]
Commands: status, start, stop, restart, logs, health, skills, uptime, version"""

import sys, os, json, subprocess, signal
from datetime import datetime, timezone

VERSION = "1.0.0"
SERVICES = {
    "link-preview": {"port": 8765, "file": "/home/alx/services/link-preview/server.py", "desc": "Link Preview API"},
    "poke-bot":     {"port": 8770, "file": "/home/alx/services/poke-bot/bot.py", "desc": "GitHub Auto-Triage Bot"},
    "site":         {"port": 8766, "file": "/home/alx/services/pokelabs-site/server.py", "desc": "Poke Labs Site"},
    "telegram":     {"port": 8777, "file": "/home/alx/services/telegram-bot/bot.py", "desc": "Telegram Bot"},
    "marketplace":  {"port": 8780, "file": "/home/alx/services/skills-marketplace/server.py", "desc": "Skills Marketplace"},
    "dashboard":    {"port": 8799, "file": "/home/alx/services/health-dashboard/server.py", "desc": "Health Dashboard"},
}

def get_pid(port):
    try:
        r = subprocess.run(["fuser", "-n", "tcp", str(port)], capture_output=True, text=True, timeout=3)
        pids = [int(p) for p in r.stdout.strip().split() if p.strip().isdigit()]
        return pids[0] if pids else None
    except:
        return None

def service_status(name):
    if name == "all":
        return [(s, get_pid(info["port"])) for s, info in SERVICES.items()]
    return [(name, get_pid(SERVICES[name]["port"]))]

def start_service(name):
    info = SERVICES[name]
    pid = get_pid(info["port"])
    if pid:
        return f"⚠️  {name} already running (PID {pid})"
    if not os.path.exists(info["file"]):
        return f"❌ {name} script not found: {info['file']}"
    log = f"/tmp/{name}.log"
    subprocess.Popen(
        ["nohup", "python3", info["file"], ">", log, "2", "&"],
        shell=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    return f"🚀 Started {name} (port {info['port']})"

def stop_service(name):
    pid = get_pid(SERVICES[name]["port"])
    if not pid:
        return f"⚠️  {name} not running"
    os.kill(pid, signal.SIGTERM)
    return f"🛑 Stopped {name} (PID {pid})"

def run_health():
    import urllib.request
    results = []
    up = down = 0
    for name, info in SERVICES.items():
        port = info["port"]
        try:
            req = urllib.request.Request(f"http://localhost:{port}/api/health", headers={"User-Agent": "poke-cli/1"})
            with urllib.request.urlopen(req, timeout=3) as r:
                data = json.loads(r.read())
                results.append(f"  ✅ {name}:{port} — {data.get('service', 'ok')} v{data.get('v', '?')}")
                up += 1
        except:
            try:
                req = urllib.request.Request(f"http://localhost:{port}/", headers={"User-Agent": "poke-cli/1"})
                with urllib.request.urlopen(req, timeout=3) as r:
                    results.append(f"  ✅ {name}:{port} — running (no health endpoint)")
                    up += 1
            except:
                results.append(f"  ❌ {name}:{port} — down")
                down += 1
    return "\n".join(results) + f"\n\n{up} up, {down} down"

def run_uptime():
    checker = "/home/alx/services/uptime-checker/check.py"
    if os.path.exists(checker):
        r = subprocess.run(["python3", checker], capture_output=True, text=True, timeout=15)
        return r.stdout
    return "Uptime checker not found"

def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        print(f"Commands: {', '.join(['status','start','stop','restart','health','uptime','skills','version'])}")
        return

    cmd = args[0]

    if cmd == "version":
        print(f"Poke CLI v{VERSION}")
        print(f"🐾 Poke Labs — pokelabs.org")

    elif cmd == "status":
        name = args[1] if len(args) > 1 else "all"
        if name not in SERVICES and name != "all":
            print(f"Unknown service: {name}")
            print(f"Available: {', '.join(SERVICES.keys())}")
            return
        results = service_status(name)
        for svc, pid in results:
            status = f"✅ running (PID {pid})" if pid else "❌ down"
            port = SERVICES[svc]["port"]
            print(f"  {svc}:{port} — {status}")

    elif cmd == "start":
        name = args[1] if len(args) > 1 else "all"
        targets = list(SERVICES.keys()) if name == "all" else [name]
        for t in targets:
            if t in SERVICES:
                print(start_service(t))
            else:
                print(f"Unknown: {t}")

    elif cmd == "stop":
        name = args[1] if len(args) > 1 else "all"
        targets = list(SERVICES.keys()) if name == "all" else [name]
        for t in targets:
            if t in SERVICES:
                print(stop_service(t))
            else:
                print(f"Unknown: {t}")

    elif cmd == "restart":
        name = args[1] if len(args) > 1 else "all"
        targets = list(SERVICES.keys()) if name == "all" else [name]
        for t in targets:
            if t in SERVICES:
                print(stop_service(t))
                import time; time.sleep(1)
                print(start_service(t))

    elif cmd == "health":
        print("🏥 Health Check")
        print(run_health())

    elif cmd == "uptime":
        print(run_uptime())

    elif cmd == "skills":
        print("🐾 Poke Skills Marketplace")
        print("  Skills available:")
        mkt_svc = "marketplace"
        mkt_port = SERVICES.get("marketplace", {}).get("port", 8780)
        try:
            import urllib.request
            req = urllib.request.Request(f"http://localhost:{mkt_port}/api/skills")
            with urllib.request.urlopen(req, timeout=5) as r:
                data = json.loads(r.read())
                for s in data.get("skills", []):
                    port = f":{s.get('port','')}" if s.get('port') else ""
                    print(f"  • {s['name']}{port} — {s['description'][:60]}...")
        except:
            print("  Marketplace not running. Start with: poke start marketplace")

    elif cmd == "logs":
        name = args[1] if len(args) > 1 else ""
        if not name or name not in SERVICES:
            print("Usage: poke logs <service>")
            return
        log = f"/tmp/{name}.log"
        if os.path.exists(log):
            r = subprocess.run(["tail", "-30", log], capture_output=True, text=True)
            print(r.stdout)
        else:
            print(f"No log file for {name}")

    else:
        print(f"Unknown command: {cmd}")
        print("Commands: status, start, stop, restart, health, uptime, skills, logs, version")

if __name__ == "__main__":
    main()
