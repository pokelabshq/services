#!/usr/bin/env python3
"""Poke CLI v1 — Manage Poke Labs services from the terminal.
Usage: poke <command> [args]
Commands: status, start, stop, restart, logs, health, version
Zero deps, stdlib only."""

import sys, os, subprocess, json, socket, time

VERSION = "1.0.0"
SERVICES = {
    "site":      {"name": "Poke Labs Site",   "port": 8766, "file": "pokelabs-site/server.py"},
    "preview":   {"name": "Link Preview API",  "port": 8765, "file": "link-preview/server.py"},
    "bot":       {"name": "Poke Bot",          "port": 8770, "file": "poke-bot/bot.py"},
    "telegram":  {"name": "Telegram Bot",      "port": 8777, "file": "telegram-bot/bot.py"},
    "skills":    {"name": "Skills Hub",        "port": 8780, "file": "skills-hub/server.py"},
    "registry":  {"name": "Package Registry",  "port": 8785, "file": "registry/server.py"},
    "pricing":   {"name": "Pricing API",       "port": 8790, "file": "pricing/server.py"},
    "billing":   {"name": "Billing Engine",    "port": 8795, "file": "billing/server.py"},
    "dashboard": {"name": "Health Dashboard",  "port": 8799, "file": "health-dashboard/server.py"},
}
BASE = "/home/alx/services"
LOGDIR = "/tmp"

def port_in_use(port):
    try:
        s = socket.socket(); s.settimeout(1)
        s.connect(("127.0.0.1", port)); s.close(); return True
    except: return False

def pid_file(svc): return f"/tmp/poke-{svc}.pid"

def get_pid(svc):
    pf = pid_file(svc)
    if os.path.exists(pf):
        try:
            pid = int(open(pf).read().strip())
            os.kill(pid, 0); return pid
        except: os.unlink(pf)
    return None

def cmd_status(args):
    print(f"\n{'SERVICE':<22} {'PORT':<8} {'STATUS':<10} {'PID'}")
    print("─" * 55)
    for key, svc in SERVICES.items():
        pid = get_pid(key)
        if pid:
            status, detail = "running", str(pid)
        elif port_in_use(svc["port"]):
            status, detail = "listening", "?"
        else:
            status, detail = "stopped", "—"
        print(f"{svc['name']:<22} {svc['port']:<8} {status:<10} {detail}")
    print()

def cmd_health(args):
    import urllib.request
    for key, svc in SERVICES.items():
        pid = get_pid(key)
        if not pid:
            print(f"  {svc['name']}: STOPPED")
            continue
        try:
            url = f"http://localhost:{svc['port']}/api/health"
            req = urllib.request.Request(url, headers={"User-Agent": "poke-cli/1"})
            resp = urllib.request.urlopen(req, timeout=3)
            data = json.loads(resp.read())
            ver = data.get("v", "?")
            print(f"  {svc['name']}: OK (v{ver})")
        except:
            print(f"  {svc['name']}: UNREACHABLE (pid {pid})")

def cmd_start(args):
    if not args:
        print("Usage: poke start <service>|all"); return
    targets = list(SERVICES.keys()) if args[0] == "all" else args
    for key in targets:
        if key not in SERVICES:
            print(f"  Unknown service: {key}"); continue
        svc = SERVICES[key]
        if get_pid(key) or port_in_use(svc["port"]):
            print(f"  {svc['name']} already running"); continue
        fpath = os.path.join(BASE, svc["file"])
        if not os.path.exists(fpath):
            print(f"  {svc['name']}: file not found ({fpath})"); continue
        log = open(f"{LOGDIR}/poke-{key}.log", "a")
        proc = subprocess.Popen(
            ["python3", fpath],
            stdout=log, stderr=log,
            cwd=os.path.dirname(fpath),
        )
        open(pid_file(key), "w").write(str(proc.pid))
        print(f"  Started {svc['name']} (pid {proc.pid})")

def cmd_stop(args):
    if not args:
        print("Usage: poke stop <service>|all"); return
    targets = list(SERVICES.keys()) if args[0] == "all" else args
    for key in targets:
        pid = get_pid(key)
        if not pid:
            print(f"  {SERVICES[key]['name']} not running"); continue
        try:
            os.kill(pid, 15)
            os.unlink(pid_file(key))
            print(f"  Stopped {SERVICES[key]['name']} (pid {pid})")
        except ProcessLookupError:
            os.unlink(pid_file(key))
            print(f"  {SERVICES[key]['name']} was already dead")

def cmd_restart(args):
    cmd_stop(args)
    time.sleep(1)
    cmd_start(args)

def cmd_logs(args):
    key = args[0] if args else "site"
    if key not in SERVICES:
        print(f"Unknown: {key}"); return
    logpath = f"{LOGDIR}/poke-{key}.log"
    if os.path.exists(logpath):
        lines = open(logpath).readlines()
        for line in lines[-20:]:
            print(line, end="")
    else:
        print(f"No log file for {key}")

def cmd_version(args):
    print(f"Poke CLI v{VERSION}")
    print(f"Services: {len(SERVICES)}")
    print(f"Base: {BASE}")

COMMANDS = {
    "status": cmd_status, "health": cmd_health,
    "start": cmd_start, "stop": cmd_stop,
    "restart": cmd_restart, "logs": cmd_logs,
    "version": cmd_version,
}

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Poke CLI — Poke Labs Service Manager")
        print("Usage: poke <command> [args]")
        print("Commands:", ", ".join(COMMANDS.keys()))
        return
    cmd = sys.argv[1]
    if cmd in COMMANDS:
        COMMANDS[cmd](sys.argv[2:])
    else:
        print(f"Unknown command: {cmd}. Run 'poke help'.")

if __name__ == "__main__":
    main()
